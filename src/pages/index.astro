---
// =========================================================
// LUQS COLLECTION — SEMUA teks, harga & gambar ada dalam fail ini.
// Tukar data di bahagian atas ni; HTML di bawah akan ikut sendiri.
// =========================================================
import "../styles/style.css";
import Pic from "../components/Pic.astro";
import { getImage } from "astro:assets";
import ogSrc from "../assets/images/pakej-larian.jpeg";

// Nombor WhatsApp (format: 60 + nombor tanpa 0 depan). Kena tukar juga dalam src/scripts/main.js
const WA = "601157812217";
const WA_DISPLAY = "+60 11-5781 2217";
const wa = (text?: string) =>
  `https://wa.me/${WA}` + (text ? `?text=${encodeURIComponent(text)}` : "");

const qtyTiers = [
  { qty: "10 – 19 PCS", price: "RM27" },
  { qty: "19 – 50 PCS", price: "RM25" },
  { qty: "50 – 100 PCS", price: "RM23", best: true },
  { qty: "100 – 199 PCS", price: "RM21" },
  { qty: "199 – 299 PCS", price: "RM19" },
];

// [nama, harga] — "FREE" = hijau, bermula "-" = diskaun, "Ask" = tanya
const kain = [
  ["Eyelet", "FREE"],
  ["Mini-Eyelet", "FREE"],
  ["Interlock", "FREE"],
  ["Ultron", "+RM3"],
  ["RJPK", "+RM3"],
  ["Diamond", "+RM3"],
  ["Mini Square", "+RM3"],
  ["Polycotton", "+RM4"],
  ["Lycra", "+RM7"],
  ["JQ Hole", "+RM10"],
  ["Baseball <small>(Min 50 pcs)</small>", "+RM10"],
  ["Others", "Ask"],
];
const kolar = [
  ["Roundneck", "FREE"],
  ["Polo", "+RM3"],
  ["V-Neck", "+RM3"],
  ["Retro", "+RM3"],
  ["Mandarin", "+RM3"],
  ["NFL", "+RM3"],
  ["Add Zipper", "+RM2"],
];
const lengan = [
  ["Shortsleeve", "FREE"],
  ["Longsleeve", "+RM3"],
  ["Raglan", "+RM4"],
  ["Muslimah", "+RM8"],
  ["Sleeveless", "-RM1"],
  ["Singlet", "-RM1 / -RM0.50"],
];
const upsize = [
  ["3XL", "+RM2"],
  ["4XL", "+RM4"],
  ["5XL", "+RM6"],
  ["6XL", "+RM8"],
  ["7XL", "+RM10"],
  ["8XL", "+RM12"],
  ["Kids Size", "-RM2"],
];
const lain = [
  ["Backtape", "+RM1"],
  ["Cuff", "+RM3"],
  ["Grip", "+RM2"],
  ["Pocket", "+RM3"],
  ["Rib", "+RM2"],
  ["Name / Number", "+RM3"],
];
const priceClass = (p: string) =>
  p === "FREE"
    ? "free"
    : p === "Ask"
      ? "ask"
      : p.startsWith("-")
        ? "minus"
        : undefined;

const galeri = [
  {
    file: "galeri-futsal.jpeg",
    tag: "Jersi Futsal & Sukan",
    title: "Jersi Pasukan Futsal / Sukan RNI",
    desc: "Cetakan full sublimation corak eksklusif, kain ringan & cepat serap peluh.",
  },
  {
    file: "galeri-sekolah-ppki.jpeg",
    tag: "Program Sekolah & PPKI",
    title:
      "Baju Program Sekolah / Terapi Boling & Sambutan Hari Lahir Murid PPKI",
    desc: "Tempahan pukal warga pendidik & murid SMK Belara dengan potongan Muslimah & standard.",
  },
  {
    file: "galeri-catur.jpeg",
    tag: "Kejohanan Catur",
    title: "Baju Kejohanan Catur & Program Sekolah",
    desc: "Seragam rasmi peserta dan urusetia kejohanan, kemas dan selesa dipakai sepanjang hari.",
  },
  {
    file: "galeri-universiti.jpeg",
    tag: "Kontinjen Universiti",
    title: "Baju Korporat / Batik Sublimation Kontinjen Pelajar Universiti",
    desc: "Kolar mandarin/polo moden dengan motif batik eksklusif & identiti rasmi kontinjen pelajar.",
  },
];

const testimoni = [
  {
    file: "testimoni-mahasiswa.jpeg",
    name: "Program Mahasiswa Untuk Semua",
    initials: "PM",
    quote:
      "Size ngam, print baju pon sangat detail ikut design yang diberi. Langsung tak pecah... Untuk harga sangat berbaloi dengan kualiti serta baju siap dalam masa yang diberikan.",
  },
  {
    file: "testimoni-danish.jpeg",
    name: "Danish Adam (UTM)",
    initials: "DA",
    quote:
      "Kualiti tiptop memang padu gilee... dari segi kain tu selesa sangat ketika untuk bersukan ni dan cepat serap peluh memang sangat recommended dan untuk servis pula memang admin selalu balas chat dengan laju tak sampai seminit pun dah balas...",
  },
];

const nav = [
  ["#pakej", "Pakej Larian RM35"],
  ["#harga", "Senarai Harga"],
  ["#galeri", "Galeri Tempahan"],
  ["#testimoni", "Testimoni"],
  ["#hubungi", "Hubungi Kami"],
];
const jenisTempahan = [
  "Pakej Larian RM35 / Set",
  "Jersi Sukan / Futsal",
  "Baju Korporat / Batik",
  "Baju Program Sekolah / Universiti",
  "Lain-lain",
];

const title = "LUQS Collection | Custom Jersey & Sublimation Printing";
const ogImage = new URL(
  (await getImage({ src: ogSrc, width: 1200, format: "jpg" })).src,
  Astro.site,
).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta
      name="description"
      content={`Cetak jersi & baju korporat custom design, full sublimation. Pakej larian RM35/set (baju + running bib + medal besi). Harga bermula RM19/helai. WhatsApp ${WA_DISPLAY}.`}
    />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Jersi custom bermula RM19/helai. Pakej Larian RM35/set. Respon admin bawah 1 minit."
    />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#0b1220" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23ff3d2e'/><text x='50' y='66' font-size='48' font-family='Arial' font-weight='bold' text-anchor='middle' fill='white'>LC</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- ===================== TOP BANNER ===================== -->
    <div class="top-banner">
      🔥 SLOT TEMPAHAN BULAN INI TERHAD — LOCK HARGA PROMO &amp; PAKEJ EVENT
      SEKARANG!
    </div>

    <!-- ===================== NAVIGATION ===================== -->
    <header class="navbar" id="navbar">
      <div class="container nav-inner">
        <a href="#" class="logo">
          <span class="logo-badge">LC</span>
          <span class="logo-text">
            <strong>LUQS COLLECTION</strong>
            <small>Custom Jersey &amp; Sublimation Printing</small>
          </span>
        </a>

        <nav class="nav-links" id="navLinks">
          {nav.map(([href, label], i) => (
            <a href={href}>
              {i === 0 && <span class="tag-hot">HOT</span>} {label}
            </a>
          ))}
          <a
            href={wa()}
            target="_blank"
            rel="noopener"
            class="btn btn-wa btn-sm nav-wa"
          >
            WhatsApp Sekarang
          </a>
        </nav>

        <button
          class="nav-toggle"
          id="navToggle"
          aria-label="Buka menu"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- ===================== HERO ===================== -->
    <section class="hero" id="utama">
      <div class="container hero-grid">
        <div class="hero-text">
          <span class="pill">
            100% Full Sublimation • Siap Ikut Timeline • Design Custom
          </span>
          <h1>
            Cetak Jersi &amp; Baju Korporat{" "}
            <span class="highlight">Custom Design</span> Kualiti Premium!
          </h1>
          <p class="lead">
            Tempahan khas untuk pasukan sukan, kelab, universiti, sekolah,
            korporat &amp; event larian. Cetakan warna tajam tidak pecah, fabrik
            selesa serta siap mengikut jadual yang ditetapkan.
          </p>
          <div class="hero-cta">
            <a href="#hubungi" class="btn btn-primary">
              Tempah Sekarang / Lock Slot
            </a>
            <a href={wa()} target="_blank" rel="noopener" class="btn btn-wa">
              WhatsApp {WA_DISPLAY}
            </a>
          </div>

          <div class="features">
            <div class="feature">
              <div class="feature-icon">🎨</div>
              <div>
                <strong>Design Custom</strong>
                <span>Ikut identiti &amp; tema anda</span>
              </div>
            </div>
            <div class="feature">
              <div class="feature-icon">💨</div>
              <div>
                <strong>Kain Selesa &amp; Sejuk</strong>
                <span>Cepat serap peluh &amp; ringan</span>
              </div>
            </div>
            <div class="feature">
              <div class="feature-icon">⏱️</div>
              <div>
                <strong>Siap Ikut Masa</strong>
                <span>Respon admin pantas &lt;1 minit</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-cards">
          <div class="promo-card">
            <span class="ribbon">PROMO TERHAD</span>
            <h3>Jersi Custom Team LUQS Collection</h3>
            <p class="small-muted">Harga Base Bermula</p>
            <p class="big-price">
              RM19 – RM27 <small>/ helai</small>
            </p>
            <span class="chip">MIN 10 PCS</span>
          </div>
          <div class="promo-card promo-card--hot">
            <span class="ribbon ribbon--yellow">KOMBO EVENT PALING LARIS</span>
            <p class="small-muted">SLOT BULAN INI TERHAD</p>
            <h3>Set Running Bib + Medal Besi + Baju Sublimation</h3>
            <p class="big-price">
              RM35 <small>/ set</small>
            </p>
            <a href="#pakej" class="link-arrow">
              Lihat pakej →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== PAKEJ LARIAN RM35 ===================== -->
    <section class="section section-dark" id="pakej">
      <div class="container pakej-grid">
        <figure
          class="pakej-image zoomable"
          data-caption="Set Lengkap Neon Run — Baju Sublimation + Running Bib 01 + Medal Besi"
        >
          <Pic
            file="pakej-larian.jpeg"
            alt="Set Lengkap Neon Run: Baju Sublimation, Running Bib dan Medal Besi"
          />
          <span class="zoom-hint">🔍 Klik Besarkan</span>
          <figcaption>
            <strong>SET LENGKAP NEON RUN</strong>
            Baju Sublimation + Running Bib 01 + Medal Besi
          </figcaption>
        </figure>

        <div class="pakej-info">
          <span class="section-tag">🔥 PAKEJ LARIAN • PALING LARIS</span>
          <h2>Set Event Larian Lengkap 3-Dalam-1</h2>
          <p>
            Khas untuk penganjur Fun Run, Larian Amal, Sekolah, Universiti &amp;
            Agensi! Lebih jimat, lebih kemas dan siap serentak dalam satu
            tempahan:
          </p>

          <div class="combo-price">
            <div>
              <span class="small-muted">Harga Combo Istimewa</span>
              <p class="big-price">
                RM35 <small>/ SET (PAX)</small>
              </p>
            </div>
            <div class="combo-badges">
              <span class="chip chip-yellow">JIMAT BERGANDA</span>
              <span class="chip">Semua 3 Item Custom Design</span>
            </div>
          </div>

          <ol class="combo-list">
            <li>
              <strong>Baju Sublimation</strong>
              <span>
                Kain microfiber selesa, full sublimation warna terang &amp;
                cepat kering.
              </span>
            </li>
            <li>
              <strong>Running Bib</strong>
              <span>
                Bib nombor peserta custom kalis air &amp; tahan koyak berserta
                pin.
              </span>
            </li>
            <li>
              <strong>Medal Besi Custom</strong>
              <span>
                Medal besi berkualiti tinggi lengkap dengan tali lanyard custom
                event.
              </span>
            </li>
          </ol>

          <div class="hero-cta">
            <a
              href="#hubungi"
              class="btn btn-primary"
              data-jenis="Pakej Larian RM35 / Set"
            >
              Lock Slot Pakej RM35 Sekarang
            </a>
            <a
              href={wa(
                "Hi LUQS Collection, saya berminat dengan Pakej Larian RM35/set.",
              )}
              target="_blank"
              rel="noopener"
              class="btn btn-wa"
            >
              WhatsApp Admin
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== SENARAI HARGA ===================== -->
    <section class="section" id="harga">
      <div class="container">
        <div class="section-head">
          <span class="section-tag">
            HARGA KILANG TERUS • LEBIH BANYAK LEBIH MURAH
          </span>
          <h2>Senarai Harga Rasmi LUQS Collection</h2>
          <p>
            Harga base adalah berdasarkan sehelai{" "}
            <strong>Eyelet Roundneck Shortsleeve</strong> jersey. Lebih banyak
            kuantiti tempahan, lebih jimat harga sehelai!
          </p>
        </div>

        <!-- 1. Harga Base -->
        <div class="price-block">
          <h3>
            <span class="num">1</span> Harga Base Mengikut Kuantiti{" "}
            <small>(Quantity &amp; Price)</small>
          </h3>
          <div class="qty-grid">
            {qtyTiers.map((t) => (
              <div class:list={["qty-card", { "qty-card--best": t.best }]}>
                {t.best && <em>PALING LARIS</em>}
                <span>{t.qty}</span>
                <strong>{t.price}</strong>
                <small>/ helai</small>
              </div>
            ))}
            <div class="qty-card qty-card--nego">
              <span>299 PCS KE ATAS</span>
              <strong>NEGO</strong>
              <small>Harga Istimewa Pukal</small>
            </div>
          </div>
        </div>

        <div class="price-columns">
          <!-- 2. Jenis Kain -->
          <div class="price-block">
            <h3>
              <span class="num">2</span> Jenis Kain <small>(Fabric)</small>
            </h3>
            <ul class="price-list">
              {kain.map(([n, p]) => (
                <li>
                  <Fragment set:html={n} /> <b class={priceClass(p)}>{p}</b>
                </li>
              ))}
            </ul>
          </div>

          <!-- 3. Kolar & Lengan -->
          <div class="price-block">
            <h3>
              <span class="num">3</span> Kolar &amp; Lengan{" "}
              <small>(Collar &amp; Sleeve)</small>
            </h3>
            <h4>Jenis Kolar (Collar)</h4>
            <ul class="price-list">
              {kolar.map(([n, p]) => (
                <li>
                  {n} <b class={priceClass(p)}>{p}</b>
                </li>
              ))}
            </ul>
            <h4>Jenis Lengan (Sleeve)</h4>
            <ul class="price-list">
              {lengan.map(([n, p]) => (
                <li>
                  {n} <b class={priceClass(p)}>{p}</b>
                </li>
              ))}
            </ul>
          </div>

          <!-- 4 & 5 -->
          <div class="price-block">
            <h3>
              <span class="num">4</span> Saiz Besar <small>(Upsize)</small>
            </h3>
            <ul class="price-list">
              {upsize.map(([n, p]) => (
                <li>
                  {n} <b class={priceClass(p)}>{p}</b>
                </li>
              ))}
            </ul>

            <h3 class="mt">
              <span class="num">5</span> Lain-lain <small>(Others)</small>
            </h3>
            <ul class="price-list">
              {lain.map(([n, p]) => (
                <li>
                  {n} <b class={priceClass(p)}>{p}</b>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Poster -->
        <figure
          class="poster zoomable"
          data-caption="Poster Senarai Harga Rasmi LUQS Collection"
        >
          <Pic
            file="poster-harga.jpeg"
            alt="Poster Senarai Harga Rasmi LUQS Collection"
            sizes="(max-width: 1100px) 100vw, 1100px"
          />
          <span class="zoom-hint">🔍 Klik Besarkan Poster</span>
          <figcaption>Poster Senarai Harga Rasmi LUQS Collection</figcaption>
        </figure>

        <div class="cta-box">
          <p>
            Nak dapatkan quotation tepat mengikut kuantiti &amp; spesifikasi
            tempahan anda?
          </p>
          <div class="hero-cta">
            <a href="#hubungi" class="btn btn-primary">
              Tempah Sekarang / Lock Slot
            </a>
            <a
              href={wa("Hi LUQS Collection, saya nak minta quotation.")}
              target="_blank"
              rel="noopener"
              class="btn btn-wa"
            >
              Minta Quotation di WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== GALERI ===================== -->
    <section class="section section-alt" id="galeri">
      <div class="container">
        <div class="section-head">
          <span class="section-tag">HASIL KERJA SEBENAR</span>
          <h2>Galeri Hasil Kerja &amp; Tempahan Pelanggan</h2>
          <p>
            Dipercayai oleh pasukan futsal, sekolah, kelab universiti dan
            penganjur acara larian di seluruh Malaysia. Klik pada gambar untuk
            paparan penuh.
          </p>
        </div>

        <div class="gallery-grid">
          {galeri.map((g) => (
            <article class="gallery-card">
              <figure class="zoomable" data-caption={g.title}>
                <Pic
                  file={g.file}
                  alt={g.title}
                  sizes="(max-width: 768px) 100vw, 33vw"
                />
                <span class="gallery-tag">{g.tag}</span>
              </figure>
              <div class="gallery-body">
                <h3>{g.title}</h3>
                <p>{g.desc}</p>
              </div>
            </article>
          ))}

          <article class="gallery-card gallery-card--wide">
            <figure
              class="zoomable"
              data-caption="Set Baju Larian, Running Bib & Medal Besi Neon Run — RM35/set"
            >
              <Pic
                file="pakej-larian.jpeg"
                alt="Set Baju Larian, Running Bib & Medal Besi Neon Run"
              />
              <span class="gallery-tag gallery-tag--hot">COMBO RM35 / SET</span>
            </figure>
            <div class="gallery-body">
              <span class="chip chip-yellow">PAKEJ TERLARIS EVENT</span>
              <h3>Set Baju Larian, Running Bib &amp; Medal Besi Neon Run</h3>
              <p>
                Penyelesaian lengkap untuk penganjur larian. Baju jersey
                sublimation penuh, bib nombor peserta 01 tahan lasak, dan medal
                besi custom dengan lanyard berwarna pada hanya{" "}
                <strong>RM35/set</strong>.
              </p>
              <span class="small-muted">🔍 Klik untuk zum gambar penuh</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ===================== TESTIMONI ===================== -->
    <section class="section" id="testimoni">
      <div class="container">
        <div class="section-head">
          <span class="section-tag">APA KATA MEREKA?</span>
          <h2>Testimoni &amp; Maklum Balas Pelanggan</h2>
          <p>
            Tangkap layar perbualan WhatsApp sebenar daripada pelanggan yang
            berpuas hati dengan kualiti cetakan dan servis pantas LUQS
            Collection.
          </p>
        </div>

        <div class="testi-grid">
          {testimoni.map((t) => (
            <article class="testi-card">
              <figure
                class="testi-shot zoomable"
                data-caption={`Feedback: ${t.name}`}
              >
                <Pic
                  file={t.file}
                  alt={`Screenshot Feedback ${t.name}`}
                  sizes="(max-width: 768px) 100vw, 50vw"
                />
                <span class="zoom-hint">Klik baca mesej penuh</span>
              </figure>
              <div class="stars" aria-label="5 daripada 5 bintang">
                ★★★★★ <small>(5.0 / 5.0)</small>
              </div>
              <blockquote>"{t.quote}"</blockquote>
              <div class="testi-author">
                <span class="avatar">{t.initials}</span>
                <div>
                  <strong>{t.name}</strong>
                  <small>✔ Tempahan Disahkan</small>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== HUBUNGI / BORANG ===================== -->
    <section class="section section-dark" id="hubungi">
      <div class="container contact-grid">
        <div>
          <span class="section-tag">RESPON PANTAS BAWAH 1 MINIT</span>
          <h2>Tempahan &amp; Pertanyaan Pantas</h2>
          <p>
            Hubungi talian WhatsApp rasmi kami di{" "}
            <a href={wa()} target="_blank" rel="noopener" class="wa-link">
              {WA_DISPLAY}
            </a>{" "}
            atau isi borang di bawah untuk terus hantar butiran tempahan anda.
          </p>
          <ul class="contact-points">
            <li>✅ Design custom ikut identiti anda</li>
            <li>✅ Harga kilang terus — lebih banyak lebih murah</li>
            <li>✅ Siap ikut timeline event</li>
          </ul>
        </div>

        <form class="order-form" id="orderForm" novalidate>
          <label>
            Nama Anda / Organisasi <span class="req">*</span>
            <input
              type="text"
              name="nama"
              required
              placeholder="cth: Kelab Futsal UTM"
            />
          </label>
          <label>
            No. Telefon (WhatsApp) <span class="req">*</span>
            <input
              type="tel"
              name="telefon"
              required
              placeholder="cth: 012-345 6789"
            />
          </label>
          <label>
            Jenis Tempahan <span class="req">*</span>
            <select name="jenis" id="jenisTempahan" required>
              <option value="">— Pilih jenis tempahan —</option>
              {jenisTempahan.map((j) => (
                <option>{j}</option>
              ))}
            </select>
          </label>
          <label>
            Anggaran Kuantiti (Helai / Set) <span class="req">*</span>
            <input
              type="number"
              name="kuantiti"
              min="1"
              required
              placeholder="cth: 50"
            />
          </label>
          <label>
            Catatan Tambahan{" "}
            <small>(Pilihan Kain / Kolar / Tarikh Event)</small>
            <textarea
              name="catatan"
              rows="3"
              placeholder="cth: Kain Eyelet, kolar polo, event 20 Disember"
            ></textarea>
          </label>
          <p class="form-error" id="formError" hidden>
            Sila isi semua ruangan bertanda *.
          </p>
          <button type="submit" class="btn btn-wa btn-block">
            Lock Slot &amp; Hantar Butiran
