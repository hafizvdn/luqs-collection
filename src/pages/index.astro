        <path d="M16.04 3C9.4 3 4 8.38 4 15.01c0 2.12.56 4.19 1.62 6.01L4 29l8.17-1.6a12.05 12.05 0 0 0 3.87.64C22.68 28.04 28 22.66 28 16.03 28 9.4 22.68 3 16.04 3Zm0 22.86c-1.23 0-2.44-.24-3.57-.71l-.26-.11-4.85.95.97-4.71-.17-.27a9.9 9.9 0 0 1-1.52-5.28c0-5.5 4.47-9.98 9.4-9.98 5.48 0 9.79 4.48 9.79 9.98s-4.31 10.13-9.79 10.13Zm5.48-7.43c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.62.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
