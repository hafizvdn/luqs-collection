---
// Gambar dari src/assets/images/. Astro auto-kecilkan & tukar ke WebP masa build.
// Kalau fail belum ada, papar kotak placeholder (build tak gagal).
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props { file: string; alt: string; sizes?: string; loading?: "lazy" | "eager" }
const { file, alt, sizes = "(max-width: 768px) 100vw, 50vw", loading = "lazy" } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/*", { eager: true });
const img = images[`/src/assets/images/${file}`]?.default;
// Versi besar untuk lightbox (popup)
const full = img && (await getImage({ src: img, width: Math.min(1600, img.width) }));
---
{img ? (
  <Image src={img} alt={alt} widths={[400, 800, 1200].filter((w) => w < img.width).concat(img.width)} sizes={sizes} loading={loading} data-full={full!.src} />
) : (
  <div class="img-missing">📷 Letak gambar di: src/assets/images/{file}</div>
)}
